{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp001-next-model-selection.schema.json",
  "title": "EXP-001 next complementary model selection dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class", "selection_id", "selection_status", "scientific_status",
    "evidence_eligible", "expert_validated", "claim_ids", "selection_observed_prior_result",
    "baseline_cohort", "selection_basis", "candidates", "rejected_alternatives",
    "comparison_policy", "approval_required_before"
  ],
  "properties": {
    "artifact_class": {"const": "exp001-next-model-selection"},
    "selection_id": {"const": "exp001-next-models-v1.0.0"},
    "selection_status": {"enum": ["proposal_frozen_no_download", "approval_requested", "authorized", "published"]},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "selection_observed_prior_result": {"const": false},
    "baseline_cohort": {
      "type": "object", "additionalProperties": false,
      "required": ["original_three_model_ids", "already_tested_control_ids", "pooling_forbidden"],
      "properties": {
        "original_three_model_ids": {"const": ["EleutherAI/pythia-70m-deduped", "HuggingFaceTB/SmolLM2-360M", "Qwen/Qwen3-0.6B-Base"]},
        "already_tested_control_ids": {"const": ["openai-community/gpt2", "HuggingFaceTB/SmolLM2-135M"]},
        "pooling_forbidden": {"const": true}
      }
    },
    "selection_basis": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "candidates": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/candidate"}},
    "rejected_alternatives": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/rejected"}},
    "comparison_policy": {"$ref": "#/$defs/comparison_policy"},
    "approval_required_before": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "role", "model_id", "revision", "source_url", "revision_url", "config_url",
        "license_id", "license_url", "gated", "provider", "architecture", "model_type",
        "parameter_count", "num_hidden_layers", "hidden_size", "vocab_size", "context_length",
        "training_corpus_summary", "runtime_files", "estimated_runtime_bytes", "local_root",
        "acquisition_status", "source_evidence", "compatibility_mapping", "unknown_until_authorized_acquisition"
      ],
      "properties": {
        "role": {"enum": ["architecture_family_control", "provider_scale_control"]},
        "model_id": {"enum": ["EleutherAI/gpt-neo-125m", "Qwen/Qwen2.5-0.5B"]},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
        "revision_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
        "config_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
        "license_id": {"enum": ["MIT", "Apache-2.0"]},
        "license_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
        "gated": {"const": false},
        "provider": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "model_type": {"type": "string", "minLength": 1},
        "parameter_count": {"type": "integer", "minimum": 1},
        "num_hidden_layers": {"type": "integer", "minimum": 1},
        "hidden_size": {"type": "integer", "minimum": 1},
        "vocab_size": {"type": "integer", "minimum": 1},
        "context_length": {"type": "integer", "minimum": 1},
        "training_corpus_summary": {"type": "string", "minLength": 1},
        "runtime_files": {"type": "array", "minItems": 7, "items": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"}},
        "estimated_runtime_bytes": {"type": "integer", "minimum": 1},
        "local_root": {"type": "string", "pattern": "^artifacts/models/[a-z0-9.-]+$"},
        "acquisition_status": {"const": "not_acquired"},
        "source_evidence": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^https://"}},
        "compatibility_mapping": {"$ref": "#/$defs/mapping"},
        "unknown_until_authorized_acquisition": {"type": "array", "minItems": 4, "items": {"type": "string"}}
      }
    },
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["causal_teacher_forced", "fast_tokenizer_offsets_required", "trust_remote_code", "hidden_state_semantics", "incompatibility_is_terminal"],
      "properties": {
        "causal_teacher_forced": {"const": true},
        "fast_tokenizer_offsets_required": {"const": true},
        "trust_remote_code": {"const": false},
        "hidden_state_semantics": {"type": "string", "minLength": 1},
        "incompatibility_is_terminal": {"const": true}
      }
    },
    "rejected": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "reason"],
      "properties": {"model_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}
    },
    "comparison_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["run_independently", "pool_scores_across_models", "preserve_terminal_outcomes", "no_post_hoc_substitution", "same_frozen_protocol"],
      "properties": {
        "run_independently": {"const": true},
        "pool_scores_across_models": {"const": false},
        "preserve_terminal_outcomes": {"const": true},
        "no_post_hoc_substitution": {"const": true},
        "same_frozen_protocol": {"const": true}
      }
    }
  }
}
