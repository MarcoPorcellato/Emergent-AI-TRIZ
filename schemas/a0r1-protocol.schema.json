{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0r1-protocol.schema.json",
  "title": "A0-R Tier R1 pre-output protocol contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "protocol_id",
    "protocol_status",
    "empirical",
    "scientific_status",
    "evidence_eligible",
    "expert_validated",
    "claim_ids",
    "protocol_type",
    "independence_audit",
    "model",
    "tokenizer",
    "runtime",
    "primary_endpoint",
    "sensitivity_endpoints",
    "shortcut_evaluation",
    "thresholds",
    "calibration",
    "outcome_rules",
    "outcome_classes",
    "status"
  ],
  "properties": {
    "artifact_class": {
      "const": "a0-r1-protocol"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^a0-r1-tier-r1-v\\d+\\.\\d+$"
    },
    "protocol_status": {
      "type": "string",
      "enum": ["planned", "frozen"]
    },
    "empirical": {
      "type": "boolean",
      "const": true
    },
    "scientific_status": {
      "type": "string",
      "const": "exploratory"
    },
    "evidence_eligible": {
      "type": "boolean",
      "const": false
    },
    "expert_validated": {
      "type": "boolean",
      "const": false
    },
    "claim_ids": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protocol_type": {
      "type": "string",
      "const": "pre_output_replication"
    },
    "independence_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_protocol_id",
        "source_protocol_merge_sha",
        "source_protocol_run_id",
        "a0_case_text_reused",
        "a0_template_ids_reused",
        "a0_seed_reused"
      ],
      "properties": {
        "source_protocol_id": {
          "type": "string",
          "const": "a0-automated-weak-proxy-v1.0.3"
        },
        "source_protocol_merge_sha": {
          "type": "string",
          "const": "fc80976d3a256ed88e2d59f1a6f893e15154e3a0"
        },
        "source_protocol_run_id": {
          "type": "string",
          "const": "a0-v1.0.3-e93a9faa"
        },
        "a0_case_text_reused": {
          "type": "boolean",
          "const": false
        },
        "a0_template_ids_reused": {
          "type": "boolean",
          "const": false
        },
        "a0_seed_reused": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "revision",
        "cached"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "EleutherAI/pythia-70m-deduped"
        },
        "revision": {
          "type": "string",
          "const": "e93a9faa9c77e5d09219f6c868bfc7a1bd65593c"
        },
        "cached": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "EleutherAI/pythia-70m-deduped"
        },
        "revision": {
          "type": "string",
          "const": "e93a9faa9c77e5d09219f6c868bfc7a1bd65593c"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_interactive_model_server",
        "runtime_device"
      ],
      "properties": {
        "requires_interactive_model_server": {
          "type": "boolean",
          "const": false
        },
        "runtime_device": {
          "type": "string",
          "const": "cpu"
        }
      }
    },
    "primary_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "token_site",
        "primary_view",
        "surface_baseline_view",
        "is_max_statistic_selection",
        "multiplicity"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "const": 6
        },
        "token_site": {
          "type": "string",
          "const": "mean_transformation_span"
        },
        "primary_view": {
          "type": "string",
          "const": "problem_plus_transformation"
        },
        "surface_baseline_view": {
          "type": "string",
          "const": "problem_only"
        },
        "is_max_statistic_selection": {
          "type": "boolean",
          "const": false
        },
        "multiplicity": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "sensitivity_endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "token_sites", "views", "may_replace_primary", "interpretation"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "integer", "enum": [0, 2, 4, 6]}
        },
        "token_sites": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["sentinel", "final_transformation_token", "mean_transformation_span"]
          }
        },
        "views": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "problem_only",
              "transformation_only",
              "problem_plus_transformation",
              "problem_plus_solution"
            ]
          }
        },
        "may_replace_primary": {"type": "boolean", "const": false},
        "interpretation": {"type": "string", "const": "descriptive_only"}
      }
    },
    "shortcut_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro_f1_threshold",
        "margin_over_majority",
        "a0_controls"
      ],
      "properties": {
        "macro_f1_threshold": {
          "type": "number",
          "const": 0.65
        },
        "margin_over_majority": {
          "type": "number",
          "const": 0.1
        },
        "a0_controls": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "bag_of_words_baselines",
              "character_ngram_baselines",
              "length_and_punctuation_baselines",
              "style_and_template_baselines",
              "provenance_classifiers",
              "problem_only_label_prediction",
              "leave_one_domain_out_surface_evaluation",
              "duplicate_and_near_duplicate_detection",
              "family_leakage_detection",
              "random_label_controls",
              "random_partition_controls",
              "generic_action_taxonomy_controls",
              "generic_transformation_taxonomy_controls",
              "adjacent_principle_proxy_controls"
            ]
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_successes",
        "primary_permutation_p_at_most",
        "macro_f1_margin_at_least",
        "family_successes_at_least",
        "domain_direction_successes_minimum"
      ],
      "properties": {
        "critical_successes": {
          "type": "integer",
          "const": 17
        },
        "primary_permutation_p_at_most": {
          "type": "number",
          "const": 0.05
        },
        "macro_f1_margin_at_least": {
          "type": "number",
          "const": 0.1
        },
        "family_successes_at_least": {
          "type": "integer",
          "const": 17
        },
        "domain_direction_successes_minimum": {
          "type": "integer",
          "const": 4
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "selection_mode",
        "deterministic_seed",
        "power",
        "maximum_false_positive_rate",
        "target_effect_size",
        "minimum_detectable_effect",
        "selected_families_per_domain",
        "selected_family_count",
        "selected_permutation_budget",
        "critical_successes",
        "family_successes_at_least"
      ],
      "properties": {
        "method": {
          "type": "string",
          "const": "exact_family_blocked_binomial_primary_endpoint"
        },
        "selection_mode": {
          "type": "string",
          "const": "deterministic_predeclared"
        },
        "deterministic_seed": {
          "type": "integer",
          "const": 20260815
        },
        "power": {
          "type": "number",
          "const": 0.8
        },
        "maximum_false_positive_rate": {
          "type": "number",
          "const": 0.05
        },
        "target_effect_size": {
          "type": "number",
          "const": 0.30
        },
        "minimum_detectable_effect": {
          "type": "number",
          "const": 0.2597184664182352
        },
        "selected_families_per_domain": {
          "type": "integer",
          "const": 4
        },
        "selected_family_count": {
          "type": "integer",
          "const": 24
        },
        "selected_permutation_budget": {
          "type": "integer",
          "const": 999
        },
        "critical_successes": {
          "type": "integer",
          "const": 17
        },
        "family_successes_at_least": {
          "type": "integer",
          "const": 17
        }
      }
    },
    "outcome_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "null",
        "failed",
        "non_interpretable"
      ],
      "properties": {
        "positive": {
          "type": "string",
          "const": "all gates pass and primary_permutation_p <= 0.05 and macro_f1_margin_over_surface >= 0.10 and family_successes >= 17"
        },
        "null": {
          "type": "string",
          "const": "all gates pass and positive rule is false"
        },
        "failed": {
          "type": "string",
          "const": "integrity, identity, execution, data, or receipt gate fails before a valid statistic"
        },
        "non_interpretable": {
          "type": "string",
          "const": "shortcut controls reach or exceed refusal threshold"
        }
      }
    },
    "outcome_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "null",
        "failed",
        "non_interpretable"
      ],
      "properties": {
        "positive": {
          "type": "string",
          "const": "positive"
        },
        "null": {
          "type": "string",
          "const": "null"
        },
        "failed": {
          "type": "string",
          "const": "failed"
        },
        "non_interpretable": {
          "type": "string",
          "const": "non_interpretable"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["planned", "frozen"]
    }
  }
}
