{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp001-r3-sealed-target.schema.json",
  "title": "EXP-001 R3 sealed response key record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "expected_choice"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^(?:[a-z0-9-]+-(?:transfer-blinded|lexical-control|transfer-exposed)|matrix2003-cell-[a-z0-9-]+-matrix-(?:forward|reverse|nonrecommendation)|panitz-edge-[a-z0-9-]+-tool-abstention)$"},
    "expected_choice": {"enum": ["A", "B", "C", "D"]}
  }
}
