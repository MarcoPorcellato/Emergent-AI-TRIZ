{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp002-approval-dossier.schema.json",
  "title": "EXP-002 material execution approval dossier",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "dossier_id", "protocol_id", "status", "exact_models", "permissions_requested", "limits", "prohibitions", "operator_approval", "scientific_status", "claim_ids"],
  "properties": {
    "artifact_class": {"const": "exp002-approval-dossier"},
    "dossier_id": {"const": "exp002-followup-execution-approval-v1"},
    "protocol_id": {"const": "exp002-qwen3-followup-v1.0.0"},
    "status": {"enum": ["approval_requested", "authorized", "rejected", "consumed"]},
    "exact_models": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["model_id", "revision", "local_root"], "properties": {"model_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "local_root": {"type": "string", "pattern": "^artifacts/models/[a-z0-9.-]+$"}}}},
    "permissions_requested": {"type": "object", "additionalProperties": false, "required": ["model_load", "generation", "network", "sealed_target_read", "ccp_material_run", "publish_every_terminal_outcome"], "properties": {"model_load": {"const": true}, "generation": {"const": false}, "network": {"const": false}, "sealed_target_read": {"const": "exactly_one_at_analysis_boundary"}, "ccp_material_run": {"const": true}, "publish_every_terminal_outcome": {"const": true}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["wall_time_seconds_per_model", "peak_rss_bytes_per_model", "new_dense_output_bytes_per_model"], "properties": {"wall_time_seconds_per_model": {"const": 1800}, "peak_rss_bytes_per_model": {"const": 8589934592}, "new_dense_output_bytes_per_model": {"const": 134217728}}},
    "prohibitions": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}},
    "operator_approval": {"type": "object", "additionalProperties": false, "required": ["granted", "operator_id", "approved_at", "approval_text_sha256"], "properties": {"granted": {"type": "boolean"}, "operator_id": {"const": "MarcoPorcellato"}, "approved_at": {"type": ["string", "null"]}, "approval_text_sha256": {"type": ["string", "null"]}}},
    "scientific_status": {"const": "exploratory"},
    "claim_ids": {"type": "array", "maxItems": 0}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "authorized"}}}, "then": {"properties": {"operator_approval": {"properties": {"granted": {"const": true}, "approved_at": {"type": "string", "minLength": 1}, "approval_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}}},
    {"if": {"properties": {"status": {"const": "approval_requested"}}}, "then": {"properties": {"operator_approval": {"properties": {"granted": {"const": false}}}}}}
  ]
}
