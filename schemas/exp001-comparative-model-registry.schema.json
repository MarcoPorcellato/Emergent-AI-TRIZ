{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp001-comparative-model-registry.schema.json",
  "title": "EXP-001 comparative model registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "registry_id", "registry_status", "models", "selection_observed_prior_result", "substitution_policy"],
  "properties": {
    "artifact_class": {"const": "exp001-comparative-model-registry"},
    "registry_id": {"const": "exp001-reference-comparative-models-v1.0.0"},
    "registry_status": {"enum": ["proposal_frozen_no_download", "frozen", "approval_requested", "authorized", "published"]},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "selection_observed_prior_result": {"const": false},
    "selection_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "models": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/model"}},
    "substitution_policy": {"const": "no_model_substitution_after_freeze"},
    "download_authorization": {"enum": ["not_granted", "granted_exact_files"]},
    "model_load_authorization": {"enum": ["not_granted", "granted_exact_models"]},
    "sealed_target_authorization": {"enum": ["not_granted", "granted_one_read_per_model"]}
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model_id", "revision", "license_id", "architecture", "model_type", "num_hidden_layers", "hidden_size", "local_root", "runtime_files", "acquisition_status"],
      "properties": {
        "role": {"enum": ["first_model_retest", "prior_reference_model", "third_model"]},
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
        "revision_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
        "config_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
        "license_id": {"const": "Apache-2.0"},
        "provider": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "model_type": {"type": "string", "minLength": 1},
        "num_hidden_layers": {"type": "integer", "minimum": 1},
        "hidden_size": {"type": "integer", "minimum": 1},
        "vocab_size": {"type": "integer", "minimum": 1},
        "local_root": {"type": "string", "pattern": "^artifacts/models/[a-z0-9.-]+$"},
        "runtime_files": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"}},
        "acquisition_status": {"enum": ["already_acquired_integrity_bound_elsewhere", "not_acquired", "integrity_verified"]},
        "unknown_until_authorized_feasibility": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
