{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp001-additional-model-selection.schema.json",
  "title": "EXP-001 additional model selection dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "selection_id",
    "selection_status",
    "scientific_status",
    "evidence_eligible",
    "expert_validated",
    "claim_ids",
    "selection_observed_prior_result",
    "selection_basis",
    "existing_model_families",
    "candidates",
    "comparison_policy",
    "approval_required_before"
  ],
  "properties": {
    "artifact_class": {"const": "exp001-additional-model-selection"},
    "selection_id": {"const": "exp001-additional-models-v1.0.0"},
    "selection_status": {"enum": ["proposal_frozen_no_download", "approval_requested", "authorized", "published"]},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "selection_observed_prior_result": {"const": false},
    "selection_basis": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "existing_model_families": {
      "type": "array",
      "const": ["gpt_neox", "llama", "qwen3"]
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "comparison_policy": {"$ref": "#/$defs/comparison_policy"},
    "approval_required_before": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "model_id",
        "revision",
        "source_url",
        "revision_url",
        "config_url",
        "license_id",
        "gated",
        "provider",
        "architecture",
        "model_type",
        "parameter_count",
        "num_hidden_layers",
        "hidden_size",
        "vocab_size",
        "training_corpus_summary",
        "local_root",
        "runtime_files",
        "declared_runtime_bytes",
        "acquisition_status",
        "compatibility_mapping",
        "unknown_until_authorized_feasibility"
      ],
      "properties": {
        "role": {"enum": ["architecture_diversity_control", "same_family_scale_control"]},
        "model_id": {"type": "string", "enum": ["openai-community/gpt2", "HuggingFaceTB/SmolLM2-135M"]},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
        "revision_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
        "config_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
        "license_id": {"enum": ["MIT", "Apache-2.0"]},
        "gated": {"const": false},
        "provider": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "model_type": {"type": "string", "minLength": 1},
        "parameter_count": {"type": "integer", "minimum": 1},
        "num_hidden_layers": {"type": "integer", "minimum": 1},
        "hidden_size": {"type": "integer", "minimum": 1},
        "vocab_size": {"type": "integer", "minimum": 1},
        "training_corpus_summary": {"type": "string", "minLength": 1},
        "local_root": {"type": "string", "pattern": "^artifacts/models/[a-z0-9.-]+$"},
        "runtime_files": {
          "type": "array",
          "minItems": 7,
          "items": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"}
        },
        "declared_runtime_bytes": {"type": "integer", "minimum": 1},
        "acquisition_status": {"const": "not_acquired"},
        "compatibility_mapping": {"$ref": "#/$defs/mapping"},
        "unknown_until_authorized_feasibility": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["causal_teacher_forced", "fast_tokenizer_offsets_required", "hidden_state_semantics", "incompatibility_is_terminal"],
      "properties": {
        "causal_teacher_forced": {"const": true},
        "fast_tokenizer_offsets_required": {"const": true},
        "hidden_state_semantics": {"type": "string", "minLength": 1},
        "incompatibility_is_terminal": {"const": true}
      }
    },
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_independently", "pool_scores_across_models", "preserve_terminal_outcomes", "no_post_hoc_substitution"],
      "properties": {
        "run_independently": {"const": true},
        "pool_scores_across_models": {"const": false},
        "preserve_terminal_outcomes": {"const": true},
        "no_post_hoc_substitution": {"const": true}
      }
    }
  }
}
