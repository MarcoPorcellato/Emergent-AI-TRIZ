{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0-statistical-result.schema.json",
  "title": "A0 sealed statistical result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "empirical",
    "scientific_status",
    "evidence_eligible",
    "expert_validated",
    "claim_ids",
    "status",
    "protocol_id",
    "input_hashes",
    "design",
    "primary",
    "observed_max_family_successes",
    "maximizing_combinations",
    "max_statistic_p",
    "null_maxima",
    "surface_baseline",
    "maximum_primary_macro_f1",
    "maximum_surface_macro_f1",
    "macro_f1_margin_over_surface",
    "sensitivity",
    "outcome_rule",
    "interpretation"
  ],
  "properties": {
    "artifact_class": {"const": "a0-sealed-statistical-result"},
    "empirical": {"const": true},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "status": {"enum": ["positive", "null"]},
    "protocol_id": {"const": "a0-automated-weak-proxy-v1.0.3"},
    "input_hashes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"},
      "minProperties": 7,
      "maxProperties": 7
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "families",
        "domains",
        "layers",
        "token_sites",
        "primary_view",
        "surface_baseline_view",
        "permutation_budget",
        "critical_successes"
      ],
      "properties": {
        "cases": {"const": 48},
        "families": {"const": 24},
        "domains": {"const": 6},
        "layers": {"const": [0, 2, 4, 6]},
        "token_sites": {"const": ["sentinel", "final_transformation_token", "mean_transformation_span"]},
        "primary_view": {"const": "problem_plus_transformation"},
        "surface_baseline_view": {"const": "problem_only"},
        "permutation_budget": {"const": 199},
        "critical_successes": {"const": 19}
      }
    },
    "primary": {"type": "object", "minProperties": 12, "maxProperties": 12},
    "observed_max_family_successes": {"type": "integer", "minimum": 0, "maximum": 24},
    "maximizing_combinations": {"type": "array", "minItems": 1, "uniqueItems": true},
    "max_statistic_p": {"type": "number", "minimum": 0.005, "maximum": 1},
    "null_maxima": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "median", "maximum", "sha256"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0, "maximum": 24},
        "median": {"type": "integer", "minimum": 0, "maximum": 24},
        "maximum": {"type": "integer", "minimum": 0, "maximum": 24},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "surface_baseline": {"type": "object", "minProperties": 4, "maxProperties": 4},
    "maximum_primary_macro_f1": {"type": "number", "minimum": 0, "maximum": 1},
    "maximum_surface_macro_f1": {"type": "number", "minimum": 0, "maximum": 1},
    "macro_f1_margin_over_surface": {"type": "number", "minimum": -1, "maximum": 1},
    "sensitivity": {"type": "object", "minProperties": 2, "maxProperties": 2},
    "outcome_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_statistic_p_at_most",
        "macro_f1_margin_at_least",
        "family_successes_at_least",
        "passed"
      ],
      "properties": {
        "max_statistic_p_at_most": {"const": 0.05},
        "macro_f1_margin_at_least": {"const": 0.1},
        "family_successes_at_least": {"const": 19},
        "passed": {"type": "boolean"}
      }
    },
    "interpretation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
