{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp001-comparative-protocol.schema.json",
  "title": "EXP-001 comparative protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "protocol_id", "protocol_status", "source_protocol_id", "source_registry", "fixture_inputs", "strata", "inventory", "analysis", "model_execution", "comparison", "publication"],
  "properties": {
    "artifact_class": {"const": "exp001-comparative-reference-protocol"},
    "protocol_id": {"const": "exp001-reference-comparative-v1.0.0"},
    "protocol_status": {"enum": ["frozen_no_download_approval_requested", "frozen", "approval_requested", "authorized", "published"]},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "source_protocol_id": {"const": "exp001-reference-integrated-r3-v1.0.0"},
    "source_protocol_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_registry": {"$ref": "#/$defs/source_registry"},
    "fixture_inputs": {"type": "object", "additionalProperties": {"type": "string"}, "required": ["primary_units", "secondary_items", "matrix_cells", "tool_edges", "source_exposures", "split_receipt", "sealed_targets"]},
    "strata": {"type": "object", "required": ["TRIZ-blinded-transfer", "source-exposed-competence"], "additionalProperties": false, "properties": {"TRIZ-blinded-transfer": {"$ref": "#/$defs/stratum"}, "source-exposed-competence": {"$ref": "#/$defs/stratum"}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["records", "primary_records", "secondary_records", "teacher_forced_labels_per_record", "score_calls_per_model"], "properties": {"records": {"const": 85}, "primary_records": {"const": 72}, "secondary_records": {"const": 13}, "teacher_forced_labels_per_record": {"const": 4}, "score_calls_per_model": {"const": 340}}},
    "analysis": {"type": "object", "additionalProperties": true, "required": ["primary", "primary_units", "domains", "families_per_domain", "replicates_per_family", "test", "permutation_count", "alpha", "bootstrap_resamples", "bootstrap_seed", "positive_requires", "secondary_policy"], "properties": {"primary": {"type": "string"}, "primary_units": {"const": 24}, "domains": {"const": 6}, "families_per_domain": {"const": 2}, "replicates_per_family": {"const": 2}, "test": {"const": "exact_two_sided_domain_sign_flip_permutation"}, "permutation_count": {"const": 64}, "alpha": {"const": 0.05}, "bootstrap_resamples": {"const": 10000}, "bootstrap_seed": {"const": 20260818}, "positive_requires": {"type": "array", "minItems": 4, "items": {"type": "string"}}, "secondary_policy": {"const": "descriptive_non_pooled_source_family_stratified"}}},
    "model_execution": {"type": "object", "additionalProperties": true, "required": ["per_model_run", "local_only", "network_access", "generation", "dtype", "wall_time_seconds", "peak_rss_bytes", "new_dense_output_bytes", "sealed_target_reads", "retry_after_model_or_target_access"], "properties": {"per_model_run": {"const": "one"}, "local_only": {"const": true}, "network_access": {"const": false}, "generation": {"const": false}, "dtype": {"const": "float32"}, "wall_time_seconds": {"const": 1800}, "peak_rss_bytes": {"const": 8589934592}, "new_dense_output_bytes": {"const": 134217728}, "sealed_target_reads": {"const": "exactly_one_at_analysis_boundary"}, "retry_after_model_or_target_access": {"const": false}}},
    "comparison": {"type": "object", "additionalProperties": true, "required": ["pool_scores_across_models", "compare_terminal_results_descriptively", "compare_token_ids", "architecture_mapping", "claim"], "properties": {"pool_scores_across_models": {"const": false}, "compare_terminal_results_descriptively": {"const": true}, "compare_token_ids": {"const": false}, "architecture_mapping": {"const": "teacher_forced_choice_score_only"}, "claim": {"type": "string"}}},
    "publication": {"type": "object", "additionalProperties": true, "required": ["publish_every_terminal_outcome", "general_triz_claim_promotion", "claim_ids_must_remain_empty", "external_dense_asset_content"], "properties": {"publish_every_terminal_outcome": {"const": true}, "general_triz_claim_promotion": {"const": false}, "claim_ids_must_remain_empty": {"const": true}, "external_dense_asset_content": {"const": "requires_separate_explicit_authorization"}}},
    "approval_required_before": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "source_registry": {"type": "object", "additionalProperties": false, "required": ["sources_sha256", "principles_sha256", "web_corpus_sha256", "corpus_document_sha256", "principle_count", "source_pdf_redistribution"], "properties": {"sources_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "principles_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "web_corpus_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "corpus_document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "principle_count": {"const": 40}, "source_pdf_redistribution": {"const": "prohibited"}}},
    "stratum": {"type": "object", "additionalProperties": false, "required": ["source_text_or_names_allowed", "canonical_examples_allowed", "pool_with_other_stratum"], "properties": {"source_text_or_names_allowed": {}, "canonical_examples_allowed": {"const": false}, "pool_with_other_stratum": {"const": false}}}
  }
}
