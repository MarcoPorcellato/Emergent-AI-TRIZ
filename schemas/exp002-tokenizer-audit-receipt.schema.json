{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp002-tokenizer-audit-receipt.schema.json",
  "title": "EXP-002 tokenizer audit receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "plan_id", "status", "model_access", "weights_access", "sealed_target_access", "network", "observations", "failure_state", "scientific_status", "evidence_eligible", "expert_validated", "claim_ids"],
  "properties": {
    "artifact_class": {"const": "exp002-tokenizer-audit-receipt"},
    "plan_id": {"const": "exp002-tokenizer-audit-v1.0.0"},
    "status": {"enum": ["not_started", "completed", "incompatible", "failed"]},
    "model_access": {"const": false},
    "weights_access": {"const": false},
    "sealed_target_access": {"const": false},
    "network": {"const": false},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "failure_state": {"type": ["string", "null"]},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observation": {"type": "object", "additionalProperties": false, "required": ["model_id", "revision", "tokenizer_files_sha256", "label_token_ids", "continuation_token_counts", "prefix_boundary_ok", "special_tokens", "prompt_token_counts", "transfer_control_length_differences", "runtime_versions"], "properties": {"model_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "tokenizer_files_sha256": {"$ref": "#/$defs/hash"}, "label_token_ids": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D"], "properties": {"A": {"type": "integer", "minimum": 0}, "B": {"type": "integer", "minimum": 0}, "C": {"type": "integer", "minimum": 0}, "D": {"type": "integer", "minimum": 0}}}, "continuation_token_counts": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D"], "properties": {"A": {"type": "integer", "minimum": 1}, "B": {"type": "integer", "minimum": 1}, "C": {"type": "integer", "minimum": 1}, "D": {"type": "integer", "minimum": 1}}}, "prefix_boundary_ok": {"const": true}, "special_tokens": {"type": "object"}, "prompt_token_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}, "transfer_control_length_differences": {"type": "array", "items": {"type": "object"}}, "runtime_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}}}
  }
}
