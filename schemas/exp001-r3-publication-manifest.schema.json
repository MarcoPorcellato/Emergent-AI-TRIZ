{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/exp001-r3-publication-manifest.schema.json",
  "title": "EXP-001 R3 publication manifest",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_class", "protocol_id", "terminal_status", "publish_every_terminal_outcome", "claim_ids", "evidence_eligible", "expert_validated", "protocol", "receipt", "report", "result", "external_response_asset", "provenance"],
  "properties": {
    "artifact_class": {"const": "exp001-r3-publication-manifest"}, "protocol_id": {"const": "exp001-reference-integrated-r3-v1.0.0"},
    "terminal_status": {"enum": ["positive", "null", "failed", "non_interpretable", "incompatible"]}, "publish_every_terminal_outcome": {"const": true}, "claim_ids": {"type": "array", "maxItems": 0}, "evidence_eligible": {"const": false}, "expert_validated": {"const": false},
    "protocol": {"$ref": "#/$defs/artifact"}, "receipt": {"$ref": "#/$defs/artifact"}, "report": {"$ref": "#/$defs/artifact"}, "result": {"$ref": "#/$defs/artifact"},
    "response_index": {"$ref": "#/$defs/artifact"},
    "external_response_asset": {"type": "object", "additionalProperties": false, "required": ["locator", "sha256"], "properties": {"locator": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\s]+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["implementation", "authorization", "integrity", "feasibility", "sealed_key_access", "recovery"], "properties": {
      "implementation": {"$ref": "#/$defs/artifact"}, "authorization": {"$ref": "#/$defs/artifact"}, "integrity": {"$ref": "#/$defs/artifact"}, "feasibility": {"$ref": "#/$defs/artifact"}, "sealed_key_access": {"$ref": "#/$defs/artifact"}, "recovery": {"$ref": "#/$defs/artifact"}
    }}
  },
  "$defs": {"artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\s]+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
}
