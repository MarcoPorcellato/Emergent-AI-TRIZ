{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp002-tokenizer-audit-plan.schema.json",
  "title": "EXP-002 tokenizer audit plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "plan_id", "status", "model_access", "weights_access", "sealed_target_access", "network", "required_observations", "models", "failure_state", "no_inference", "no_target_read", "scientific_status", "claim_ids"],
  "properties": {
    "artifact_class": {"const": "exp002-tokenizer-audit-plan"},
    "plan_id": {"const": "exp002-tokenizer-audit-v1.0.0"},
    "status": {"enum": ["draft", "ready_no_model", "frozen"]},
    "model_access": {"const": false},
    "weights_access": {"const": false},
    "sealed_target_access": {"const": false},
    "network": {"const": false},
    "required_observations": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "models": {"const": "experiments/exp002-qwen3-followup/protocol.json#/models"},
    "failure_state": {"const": "incompatible"},
    "no_inference": {"const": true},
    "no_target_read": {"const": true},
    "scientific_status": {"const": "exploratory"},
    "claim_ids": {"type": "array", "maxItems": 0}
  }
}
