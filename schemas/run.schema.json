{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/run.schema.json",
  "title": "Latent TRIZ run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "study_id",
    "code_revision",
    "data_revision",
    "model_revision",
    "tokenizer",
    "prompts",
    "seeds",
    "precision",
    "device",
    "environment",
    "layer",
    "intervention",
    "token_positions",
    "output_hashes",
    "evaluator_protocol",
    "exclusions",
    "analysis_version",
    "timestamp"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "code_revision": {
      "type": "string",
      "minLength": 1
    },
    "data_revision": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "vocab_size": {
          "type": "integer",
          "minimum": 1
        },
        "pad_token_id": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "content_hash", "template_id", "value"],
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["discovery", "validation", "steering", "evaluation"]
          },
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer"
      }
    },
    "precision": {
      "type": "string",
      "enum": ["bf16", "fp16", "fp32", "fp64"]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "count"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["cpu", "cuda", "tpu", "mps", "other"]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python_version"],
      "properties": {
        "container_image": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seed_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layer": {
      "type": "integer",
      "minimum": 0
    },
    "token_positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "vector_id", "alpha", "vector_source", "strength_control_id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["steering", "ablation", "replacement", "projection", "none"]
        },
        "vector_id": {
          "type": "string",
          "minLength": 1
        },
        "alpha": {
          "type": "number"
        },
        "vector_source": {
          "type": "string",
          "minLength": 1
        },
        "strength_control_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responses", "scores", "logits"],
      "properties": {
        "responses": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scores": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "logits": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evaluator_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "version", "rater_count", "decision_rule"],
      "properties": {
        "protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rater_count": {
          "type": "integer",
          "minimum": 1
        },
        "decision_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analysis_version": {
      "type": "string",
      "minLength": 1
    },
    "analysis_artifact_uri": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "randomized_ordering": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}
