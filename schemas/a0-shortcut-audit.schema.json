{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0-shortcut-audit.schema.json",
  "title": "A0 shortcut audit artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "protocol_id",
    "empirical",
    "scientific_status",
    "evidence_eligible",
    "expert_validated",
    "claim_ids",
    "shortcut_threshold",
    "margin_over_majority",
    "counts",
    "controls",
    "status"
  ],
  "properties": {
    "artifact_class": {
      "type": "string",
      "const": "a0-shortcut-audit"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "empirical": {
      "type": "boolean",
      "const": true
    },
    "scientific_status": {
      "type": "string",
      "const": "exploratory"
    },
    "evidence_eligible": {
      "type": "boolean",
      "const": false
    },
    "expert_validated": {
      "type": "boolean",
      "const": false
    },
    "claim_ids": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shortcut_threshold": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "margin_over_majority": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "status": {
      "type": "string",
      "enum": ["pass", "failed", "non_interpretable"]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["families", "total_cases", "calibration_cases", "sealed_cases"],
      "properties": {
        "families": {
          "type": "integer",
          "minimum": 1
        },
        "total_cases": {
          "type": "integer",
          "minimum": 0
        },
        "calibration_cases": {
          "type": "integer",
          "minimum": 0
        },
        "sealed_cases": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bag_of_words_baselines",
        "character_ngram_baselines",
        "length_and_punctuation_baselines",
        "style_and_template_baselines",
        "provenance_classifiers",
        "problem_only_label_prediction",
        "leave_one_domain_out_surface_evaluation",
        "duplicate_and_near_duplicate_detection",
        "family_leakage_detection",
        "random_label_controls",
        "random_partition_controls",
        "generic_action_taxonomy_controls",
        "generic_transformation_taxonomy_controls",
        "adjacent_principle_proxy_controls",
        "overall",
        "integrity"
      ],
      "properties": {
        "bag_of_words_baselines": { "$ref": "#/$defs/cat_control" },
        "character_ngram_baselines": { "$ref": "#/$defs/cat_control" },
        "length_and_punctuation_baselines": { "$ref": "#/$defs/cat_control" },
        "style_and_template_baselines": { "$ref": "#/$defs/cat_control" },
        "provenance_classifiers": { "$ref": "#/$defs/cat_control" },
        "problem_only_label_prediction": { "$ref": "#/$defs/cat_control" },
        "leave_one_domain_out_surface_evaluation": { "$ref": "#/$defs/cat_control" },
        "duplicate_and_near_duplicate_detection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "failed", "non_interpretable"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "family_leakage_detection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "families_checked", "note"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "failed", "non_interpretable"] },
            "families_checked": { "type": "integer", "minimum": 0 },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "random_label_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "seed",
            "permutations",
            "aggregate",
            "majority_macrof1",
            "threshold",
            "margin_over_majority"
          ],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "failed", "non_interpretable"] },
            "seed": { "type": "integer", "minimum": 0 },
            "permutations": { "type": "integer", "minimum": 1 },
            "aggregate": { "$ref": "#/$defs/metrics" },
            "majority_macrof1": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "margin_over_majority": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "random_partition_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "seed", "runs", "aggregate", "threshold", "margin_over_majority"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "failed", "non_interpretable"] },
            "seed": { "type": "integer", "minimum": 0 },
            "runs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["control", "folds", "aggregate"],
                "properties": {
                  "control": { "type": "string", "minLength": 1 },
                  "folds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["fold", "metrics", "train_count", "test_count"],
                      "properties": {
                        "fold": { "type": "integer", "minimum": 0 },
                        "metrics": { "$ref": "#/$defs/metrics" },
                        "train_count": { "type": "integer", "minimum": 1 },
                        "test_count": { "type": "integer", "minimum": 1 }
                      }
                    }
                  },
                  "aggregate": { "$ref": "#/$defs/metrics" }
                }
              }
            },
            "aggregate": { "$ref": "#/$defs/metrics" },
            "threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "margin_over_majority": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "generic_action_taxonomy_controls": { "$ref": "#/$defs/cat_control_named" },
        "generic_transformation_taxonomy_controls": { "$ref": "#/$defs/cat_control_named" },
        "adjacent_principle_proxy_controls": { "$ref": "#/$defs/cat_control_named" },
        "overall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "non_interpretable", "missing_required_controls"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "failed", "non_interpretable"] },
            "non_interpretable": { "type": "boolean" },
            "missing_required_controls": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "issues"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "failed"] },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code"],
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "family_id": { "type": "string", "minLength": 1 },
                  "case_id": { "type": "string", "minLength": 1 },
                  "split": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "missing_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "controls"],
          "properties": {
            "status": { "type": "string", "const": "failed" },
            "controls": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy", "balanced_accuracy", "macro_f1"],
      "properties": {
        "accuracy": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "balanced_accuracy": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "macro_f1": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "cat_control_folds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metrics", "majority_metrics", "margin_over_majority"],
        "properties": {
          "metrics": { "$ref": "#/$defs/metrics" },
          "majority_metrics": { "$ref": "#/$defs/metrics" },
          "margin_over_majority": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "train_count": { "type": "integer", "minimum": 1 },
          "test_count": { "type": "integer", "minimum": 1 },
          "domain": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cat_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "threshold",
        "margin_over_majority",
        "min_margin_over_majority",
        "aggregate",
        "folds"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "failed", "non_interpretable"] },
        "threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "margin_over_majority": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "min_margin_over_majority": { "type": "number" },
        "aggregate": { "$ref": "#/$defs/metrics" },
        "folds": { "$ref": "#/$defs/cat_control_folds" }
      }
    },
    "cat_control_named": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "threshold",
        "margin_over_majority",
        "min_margin_over_majority",
        "aggregate",
        "folds"
      ],
      "properties": {
        "name": { "type": "string", "enum": [
          "generic_action_taxonomy_controls",
          "generic_transformation_taxonomy_controls",
          "adjacent_principle_proxy_controls"
        ] },
        "status": { "type": "string", "enum": ["pass", "failed", "non_interpretable"] },
        "threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "margin_over_majority": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "min_margin_over_majority": { "type": "number" },
        "aggregate": { "$ref": "#/$defs/metrics" },
        "folds": { "$ref": "#/$defs/cat_control_folds" }
      }
    }
  }
}
