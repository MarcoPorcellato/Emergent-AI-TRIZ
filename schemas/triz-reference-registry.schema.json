{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/triz-reference-registry.schema.json",
  "title": "Latent-TRIZ TRIZ reference registry",
  "description": "Metadata-only registry of public TRIZ references. It is not an evidence or ground-truth corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "epistemic_status", "sources"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "epistemic_status": {"const": "reference_only/non_evidence"},
    "sources": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "authors", "publication", "artifact", "authority_class", "authority_status", "rights", "citation", "intended_roles", "automatic_ground_truth", "r2_frozen_protocol_eligible", "future_tranche", "exposure_modes", "locators"],
      "properties": {
        "id": {"type": "string", "pattern": "^triz-ref-[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "publication": {"type": "object", "additionalProperties": false, "required": ["year", "publisher", "date_status"], "properties": {"year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100}, "publisher": {"type": "string", "minLength": 1}, "date_status": {"type": "string", "enum": ["verified", "unverified"]}}},
        "artifact": {"type": "object", "additionalProperties": false, "required": ["filename", "sha256", "size_bytes", "pages", "repository_copy_tracked"], "properties": {"filename": {"type": "string", "pattern": "^[^/\\\\]+\\.(pdf|PDF)$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1}, "pages": {"type": "integer", "minimum": 1}, "repository_copy_tracked": {"const": false}}},
        "authority_class": {"type": "string", "enum": ["expert-authored_public_reference", "expert-curated_public_reference"]},
        "authority_status": {"type": "string", "enum": ["verified_primary_source", "verified_provider_attribution", "user_attributed_not_independently_verified"]},
        "rights": {"type": "object", "additionalProperties": false, "required": ["status", "open_license", "distribution_note"], "properties": {"status": {"type": "string", "enum": ["copyrighted_public_download", "permission_reported_no_general_open_license", "rights_unverified"]}, "open_license": {"const": false}, "distribution_note": {"type": "string", "minLength": 1}}},
        "citation": {"type": "object", "additionalProperties": false, "required": ["landing_url", "artifact_url"], "properties": {"landing_url": {"type": "string", "format": "uri"}, "artifact_url": {"type": ["string", "null"], "format": "uri"}}},
        "intended_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["prompt_design", "test_design", "interpretation_context", "taxonomy_context", "tool_relationship_context"]}},
        "automatic_ground_truth": {"const": false},
        "r2_frozen_protocol_eligible": {"const": false},
        "future_tranche": {"const": "R3/EXP-001"},
        "exposure_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["metadata_only", "human_reviewed_excerpt", "citation_only"]}},
        "locators": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["label", "page", "purpose"], "properties": {"label": {"type": "string"}, "page": {"type": "integer", "minimum": 1}, "purpose": {"type": "string"}}}}
      }
    }
  }
}
