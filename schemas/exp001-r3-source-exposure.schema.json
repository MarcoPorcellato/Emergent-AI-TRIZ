{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://latent-triz.org/schemas/exp001-r3-source-exposure.schema.json", "title": "EXP-001 R3 bounded source exposure", "type": "object", "additionalProperties": false,
  "required": ["exposure_context_id", "item_id", "mode", "source_id", "locator", "context", "verbatim_copy", "canonical_example_included", "rights", "bounded", "blinded_counterpart_id"],
  "properties": {"exposure_context_id": {"type": "string", "pattern": "^exp001-exposure-[a-z0-9-]+$"}, "item_id": {"type": "string", "minLength": 1}, "mode": {"const": "source_exposed"}, "source_id": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "context": {"type": "string", "minLength": 1}, "verbatim_copy": {"const": false}, "canonical_example_included": {"const": false}, "rights": {"type": "object", "additionalProperties": false, "required": ["status", "redistribution_allowed", "locator_only"], "properties": {"status": {"enum": ["public_reference_external", "user_attributed_unverified"]}, "redistribution_allowed": {"const": false}, "locator_only": {"const": true}}}, "bounded": {"const": true}, "blinded_counterpart_id": {"type": "string", "minLength": 1}}
}
