{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp001-comparative-qwen-integrity-receipt.schema.json",
  "title": "EXP-001 Qwen integrity receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "status", "scientific_status", "evidence_eligible", "model_loaded", "model_output_accessed", "sealed_targets_accessed", "model_id", "revision", "license_id", "source_url", "runtime_root", "disk_budget_bytes", "total_bytes", "authorization_sha256", "retrieved_at", "runtime_files"],
  "properties": {
    "artifact_class": {"const": "exp001-comparative-qwen-integrity-receipt"},
    "status": {"const": "integrity_verified"},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "model_loaded": {"const": false},
    "model_output_accessed": {"const": false},
    "sealed_targets_accessed": {"const": false},
    "model_id": {"const": "Qwen/Qwen3-0.6B-Base"},
    "revision": {"const": "da87bfb608c14b7cf20ba1ce41287e8de496c0cd"},
    "license_id": {"const": "Apache-2.0"},
    "source_url": {"type": "string", "pattern": "^https://huggingface\\.co/"},
    "runtime_root": {"const": "artifacts/models/qwen3-0.6b-base-da87bfb"},
    "disk_budget_bytes": {"const": 1610612736},
    "total_bytes": {"const": 1203625970},
    "authorization_sha256": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "minLength": 1},
    "runtime_files": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256", "source_oid", "source_kind", "source_url"],
        "properties": {
          "path": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_oid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
          "source_kind": {"enum": ["git_blob", "lfs_sha256"]},
          "source_url": {"type": "string", "pattern": "^https://huggingface\\.co/.+/resolve/[a-f0-9]{40}/[^/]+$"}
        }
      }
    }
  }
}
