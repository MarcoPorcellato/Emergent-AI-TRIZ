{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0r2-feasibility-contract.schema.json",
  "title": "A0-R2 bounded feasibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "contract_status", "created_at", "repository_anchor", "scientific_status", "empirical", "evidence_eligible", "expert_validated", "claim_ids", "authorization", "predecessor", "model", "runtime", "probe", "compatibility", "receipt"],
  "properties": {
    "artifact_class": {"const": "a0r2-feasibility-contract"},
    "contract_status": {"const": "frozen_pre_load"},
    "created_at": {"type": "string", "format": "date-time"},
    "repository_anchor": {"const": "5d4d96c16b56715203aa8a077b13d3b6cc550fc9"},
    "scientific_status": {"const": "instrumentation_only"},
    "empirical": {"const": false},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "scope", "not_authorized"],
      "properties": {
        "status": {"const": "operator_authorized"},
        "scope": {"const": "bounded_cpu_float32_feasibility_only"},
        "not_authorized": {
          "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["sealed_target_access", "sealed_r2_execution", "scientific_outcome_inference", "model_or_tokenizer_download", "generation"]}
        }
      }
    },
    "predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["acquisition_contract", "acquisition_contract_sha256", "integrity_receipt", "integrity_receipt_sha256"],
      "properties": {
        "acquisition_contract": {"const": "experiments/a0r2-independent-model/acquisition-contract.json"},
        "acquisition_contract_sha256": {"const": "55ae5f8dffa4caef00d67e38f47c4793ccb716a054351bb752d277f0173df4e8"},
        "integrity_receipt": {"const": "results/a0r2/preexecution/smollm2-360m-f8027fd0/integrity-receipt.json"},
        "integrity_receipt_sha256": {"const": "57424b6ef65ea1ffe94f98170eee0aa5c884158f85fa92b251bb67a78a749cd3"}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "license_id", "model_type", "architecture", "num_hidden_layers", "hidden_size", "local_locator"],
      "properties": {
        "id": {"const": "HuggingFaceTB/SmolLM2-360M"},
        "revision": {"const": "f8027fd0eaeea54caa13c31d31b9fdc459c38b49"},
        "license_id": {"const": "Apache-2.0"},
        "model_type": {"const": "llama"},
        "architecture": {"const": "LlamaForCausalLM"},
        "num_hidden_layers": {"const": 32},
        "hidden_size": {"const": 960},
        "local_locator": {"const": "artifacts/models/smollm2-360m-f8027fd0"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["network_access", "local_files_only", "device", "torch_dtype", "generation", "inference_passes", "maximum_prompt_tokens", "maximum_wall_seconds", "maximum_peak_rss_bytes"],
      "properties": {
        "network_access": {"const": false}, "local_files_only": {"const": true},
        "device": {"const": "cpu"}, "torch_dtype": {"const": "float32"},
        "generation": {"const": false}, "inference_passes": {"const": 2},
        "maximum_prompt_tokens": {"const": 128}, "maximum_wall_seconds": {"const": 900},
        "maximum_peak_rss_bytes": {"const": 8589934592}
      }
    },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "purpose", "output_content_retained"],
      "properties": {
        "text": {"type": "string", "minLength": 32},
        "purpose": {"const": "synthetic_runtime_compatibility_only"},
        "output_content_retained": {"const": false}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["fast_tokenizer_offsets_required", "hidden_states_include_embeddings", "expected_hidden_states_count", "primary_semantics", "primary_hidden_states_tuple_index", "descriptive_sensitivity_tuple_indices", "finite_hidden_states_required", "finite_logits_required", "repeatability_max_abs_difference", "incompatibility_is_terminal"],
      "properties": {
        "fast_tokenizer_offsets_required": {"const": true}, "hidden_states_include_embeddings": {"const": true},
        "expected_hidden_states_count": {"const": 33},
        "primary_semantics": {"const": "final_transformer_block_output"},
        "primary_hidden_states_tuple_index": {"const": 32},
        "descriptive_sensitivity_tuple_indices": {"const": [0, 11, 21, 32]},
        "finite_hidden_states_required": {"const": true}, "finite_logits_required": {"const": true},
        "repeatability_max_abs_difference": {"const": 0.000001}, "incompatibility_is_terminal": {"const": true}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "overwrite", "terminal_statuses"],
      "properties": {
        "path": {"const": "results/a0r2/preexecution/smollm2-360m-f8027fd0/feasibility-receipt.json"},
        "overwrite": {"const": false},
        "terminal_statuses": {"const": ["compatible", "incompatible", "failed"]}
      }
    }
  }
}
