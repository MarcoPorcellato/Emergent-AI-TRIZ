{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0-publication-manifest.schema.json",
  "title": "A0 immutable publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "empirical",
    "scientific_status",
    "evidence_eligible",
    "expert_validated",
    "claim_ids",
    "status",
    "result",
    "report",
    "activation_receipt",
    "representation_index"
  ],
  "properties": {
    "artifact_class": {"const": "a0-publication-manifest"},
    "empirical": {"const": true},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "status": {"const": "pass"},
    "result": {"$ref": "#/$defs/hash_file"},
    "report": {"$ref": "#/$defs/hash_file"},
    "activation_receipt": {"$ref": "#/$defs/hash_file"},
    "representation_index": {"$ref": "#/$defs/hash_file"}
  },
  "$defs": {
    "hash_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
