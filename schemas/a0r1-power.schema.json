{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0r1-power.schema.json",
  "title": "A0-R1 power calibration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "protocol_id",
    "protocol_status",
    "method",
    "selection_mode",
    "multiplicity",
    "targets",
    "simulation",
    "selected",
    "status",
    "empirical",
    "scientific_status",
    "evidence_eligible",
    "expert_validated",
    "claim_ids",
    "model_output_accessed",
    "sealed_targets_accessed"
  ],
  "properties": {
    "artifact_class": {
      "type": "string",
      "const": "a0r1-power-calibration"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^a0-r1-tier-r1-v\\d+\\.\\d+$"
    },
    "protocol_status": {
      "type": "string",
      "enum": ["planned", "frozen"]
    },
    "method": {
      "type": "string",
      "const": "exact_primary_endpoint"
    },
    "selection_mode": {
      "type": "string",
      "const": "deterministic_simulation"
    },
    "multiplicity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "token_sites", "total"],
      "properties": {
        "layers": {
          "type": "integer",
          "const": 1
        },
        "token_sites": {
          "type": "integer",
          "const": 1
        },
        "total": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families_per_domain",
        "family_level_critical_successes",
        "family_success_probability_under_null",
        "family_success_probability_under_target"
      ],
      "properties": {
        "families_per_domain": {
          "type": "integer",
          "const": 4
        },
        "family_level_critical_successes": {
          "type": "integer",
          "const": 17
        },
        "family_success_probability_under_null": {
          "type": "number",
          "const": 0.5
        },
        "family_success_probability_under_target": {
          "type": "number",
          "const": 0.8
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "trials", "empirical_resolution", "minimum_resolvable_p", "passes_empirical_check", "min_attainable_p"],
      "properties": {
        "seed": {
          "type": "integer",
          "const": 20260815
        },
        "trials": {
          "type": "integer",
          "const": 100000
        },
        "empirical_resolution": {
          "type": "number",
          "const": 0.00001
        },
        "minimum_resolvable_p": {
          "type": "number",
          "const": 0.001
        },
        "passes_empirical_check": {
          "type": "boolean",
          "const": true
        },
        "min_attainable_p": {
          "type": "number",
          "const": 0.001
        }
      }
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families_per_domain",
        "family_count",
        "permutation_budget",
        "critical_successes",
        "minimum_attainable_p",
        "exact_false_positive_rate",
        "exact_power_at_target_success_probability",
        "minimum_detectable_effect",
        "empirical_null_fpr",
        "empirical_target_power",
        "exact_vs_empirical_tolerance"
      ],
      "properties": {
        "families_per_domain": {
          "type": "integer",
          "const": 4
        },
        "family_count": {
          "type": "integer",
          "const": 24
        },
        "permutation_budget": {
          "type": "integer",
          "const": 999
        },
        "critical_successes": {
          "type": "integer",
          "const": 17
        },
        "minimum_attainable_p": {
          "type": "number",
          "const": 0.001
        },
        "exact_false_positive_rate": {
          "type": "number",
          "const": 0.03195732831954956
        },
        "exact_power_at_target_success_probability": {
          "type": "number",
          "const": 0.9108287412264922
        },
        "minimum_detectable_effect": {
          "type": "number",
          "const": 0.2597184664182352
        },
        "empirical_null_fpr": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "empirical_target_power": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "exact_vs_empirical_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["pass", "failed"]
    },
    "empirical": {
      "type": "boolean",
      "const": true
    },
    "scientific_status": {
      "type": "string",
      "const": "exploratory"
    },
    "evidence_eligible": {
      "type": "boolean",
      "const": false
    },
    "expert_validated": {
      "type": "boolean",
      "const": false
    },
    "claim_ids": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_output_accessed": {
      "type": "boolean",
      "const": false
    },
    "sealed_targets_accessed": {
      "type": "boolean",
      "const": false
    }
  }
}
