{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/lab01-manifest.schema.json",
  "title": "Lab 01 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "empirical",
    "evidence_eligible",
    "claim_ids",
    "model",
    "revision",
    "license_id",
    "state",
    "allowed_states",
    "gates",
    "byte_identical_structures",
    "numeric_tolerance_by_backend_dtype"
  ],
  "properties": {
    "artifact_class": { "type": "string", "const": "model-instrumentation" },
    "empirical": { "type": "boolean", "const": true },
    "evidence_eligible": { "type": "boolean", "const": false },
    "claim_ids": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
    "model": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "license_id": { "type": "string", "const": "Apache-2.0" },
    "state": {
      "type": "string",
      "enum": [
        "unselected",
        "selected",
        "acquisition_planned",
        "acquired",
        "integrity_verified",
        "load_verified",
        "instrumentation_verified",
        "lab_ready"
      ]
    },
    "allowed_states": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string",
        "enum": [
          "unselected",
          "selected",
          "acquisition_planned",
          "acquired",
          "integrity_verified",
          "load_verified",
          "instrumentation_verified",
          "lab_ready"
        ]
      }
    },
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "type": "string", "enum": ["G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8"] }
    },
    "byte_identical_structures": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "numeric_tolerance_by_backend_dtype": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "required": ["atol", "rtol"],
          "properties": {
            "atol": { "type": "number", "minimum": 0 },
            "rtol": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      }
    },
    "notes": { "type": "string" }
  }
}
