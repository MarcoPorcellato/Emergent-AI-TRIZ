{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp002-response-surface-plan.schema.json",
  "title": "EXP-002 response-surface plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "plan_id", "status", "conditions", "metrics", "model_access", "sealed_target_access", "scientific_status", "claim_ids"],
  "properties": {
    "artifact_class": {"const": "exp002-response-surface-plan"},
    "plan_id": {"const": "exp002-response-surface-v1.0.0"},
    "status": {"const": "ready_no_model"},
    "conditions": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 1}},
    "metrics": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}},
    "model_access": {"const": false},
    "sealed_target_access": {"const": false},
    "scientific_status": {"const": "exploratory"},
    "claim_ids": {"type": "array", "maxItems": 0}
  }
}
