{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/lab03-config.schema.json",
  "title": "Latent TRIZ Lab 03 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "status", "seed", "random_permutations", "minimum_labels", "minimum_domains", "minimum_cases_per_label", "minimum_cases_per_held_out_domain", "minimum_cases_per_label_per_domain", "shortcut_macro_f1_threshold", "shortcut_margin_over_majority", "method_families", "allow_local_diagnostics", "families", "non_claim_boundary"],
  "properties": {
    "config_version": {"type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"},
    "status": {"type": "string", "enum": ["draft", "ready", "fail"]},
    "seed": {"type": "integer", "minimum": 0},
    "random_permutations": {"type": "integer", "minimum": 1},
    "minimum_labels": {"type": "integer", "minimum": 2},
    "minimum_domains": {"type": "integer", "minimum": 4},
    "minimum_cases_per_label": {"type": "integer", "minimum": 1},
    "minimum_cases_per_held_out_domain": {"type": "integer", "minimum": 1},
    "minimum_cases_per_label_per_domain": {"type": "integer", "minimum": 1},
    "shortcut_macro_f1_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "shortcut_margin_over_majority": {"type": "number", "minimum": 0},
    "method_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["majority", "keyword_matching", "bag_of_words", "conventional_sentence_embeddings", "topic_classification", "output_only_llm", "random_label"]}},
    "allow_local_diagnostics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["char_ngram"]}},
    "families": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conventional_sentence_embeddings": {"$ref": "#/$defs/externalFamily"},
        "topic_classification": {"$ref": "#/$defs/externalFamily"},
        "output_only_llm": {"$ref": "#/$defs/externalFamily"}
      }
    },
    "non_claim_boundary": {"type": "object", "additionalProperties": false, "required": ["empirical", "evidence_eligible", "claim_ids"], "properties": {"empirical": {"const": false}, "evidence_eligible": {"const": false}, "claim_ids": {"type": "array", "maxItems": 0}}}
  },
  "$defs": {
    "externalFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_path", "sha256"],
      "properties": {
        "status": {"const": "completed"},
        "receipt_path": {"type": "string", "pattern": "^[^/\\\\][^\\\\]*\\.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
