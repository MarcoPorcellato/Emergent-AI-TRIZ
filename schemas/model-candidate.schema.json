{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/model-candidate.schema.json",
  "title": "Latent TRIZ offline model candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "model_id",
    "revision",
    "license_id",
    "model_card_url",
    "terms_url",
    "evidence_url",
    "acquisition_status",
    "weights_present",
    "required_capabilities"
  ],
  "properties": {
    "role": {"type": "string", "enum": ["primary", "replication", "fallback"]},
    "model_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license_id": {"type": "string", "minLength": 1},
    "model_card_url": {"type": "string", "format": "uri"},
    "terms_url": {"type": "string", "format": "uri"},
    "evidence_url": {"type": "string", "format": "uri"},
    "acquisition_status": {"type": "string", "enum": ["not_acquired"]},
    "weights_present": {"type": "boolean", "const": false},
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "string"}
  }
}
