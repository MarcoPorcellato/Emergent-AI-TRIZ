{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/lab03-result.schema.json",
  "title": "Latent TRIZ Lab 03 behavioral-baseline result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "status",
    "empirical",
    "evidence_eligible",
    "claim_ids",
    "interpretation",
    "snapshot",
    "cases",
    "gates",
    "methods",
    "random_label_control",
    "issues",
    "hashes",
    "summary_artifacts"
  ],
  "properties": {
    "artifact_class": {"const": "behavioral-baseline-instrumentation"},
    "status": {"enum": ["pass", "fail"]},
    "empirical": {"const": false},
    "evidence_eligible": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "interpretation": {"enum": ["diagnostic_only_not_scientifically_interpretable", "readiness_gates_evaluable"]},
    "snapshot": {"type": "object"},
    "cases": {
      "type": "object",
      "required": ["total_cases", "label_count", "domain_count", "labels", "domains"],
      "properties": {
        "total_cases": {"type": "integer", "minimum": 1},
        "label_count": {"type": "integer", "minimum": 1},
        "domain_count": {"type": "integer", "minimum": 1},
        "labels": {"type": "array", "minItems": 1, "uniqueItems": true},
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "status", "details"],
        "properties": {
          "gate": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8"]},
          "status": {"enum": ["pass", "fail"]},
          "details": {"type": "string", "minLength": 1}
        }
      }
    },
    "methods": {"type": "object"},
    "random_label_control": {"type": "object"},
    "issues": {"type": "array"},
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_jsonl", "report_html", "summary_json", "snapshot_hash", "config_hash", "cases_hash"],
      "properties": {
        "baseline_jsonl": {"$ref": "#/$defs/sha256"},
        "report_html": {"$ref": "#/$defs/sha256"},
        "summary_json": {"$ref": "#/$defs/sha256"},
        "snapshot_hash": {"$ref": "#/$defs/sha256"},
        "config_hash": {"$ref": "#/$defs/sha256"},
        "cases_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "summary_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "readiness_statement", "baseline", "html", "summary"],
      "properties": {
        "generated_by": {"const": "lab03_report_renderer"},
        "readiness_statement": {"type": "string", "minLength": 1},
        "baseline": {"const": "baseline_result.json"},
        "html": {"const": "report.html"},
        "summary": {"const": "summary.json"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
