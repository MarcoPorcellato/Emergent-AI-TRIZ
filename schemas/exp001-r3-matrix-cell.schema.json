{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp001-r3-matrix-cell.schema.json",
  "title": "EXP-001 R3 sparse Matrix 2003 cell",
  "type": "object", "additionalProperties": false,
  "required": ["cell_id", "source_id", "locator", "direction", "improving_parameter", "worsening_parameter", "recommended_principles", "transcription_receipts", "inference_prohibited", "rights"],
  "properties": {
    "cell_id": {"type": "string", "pattern": "^matrix2003-cell-[a-z0-9-]+$"}, "source_id": {"const": "triz-ref-matrix-2003"},
    "locator": {"type": "object", "additionalProperties": false, "required": ["page", "table"], "properties": {"page": {"type": "integer", "minimum": 1}, "table": {"type": "string", "minLength": 1}}},
    "direction": {"const": "improving_row_worsening_column"}, "improving_parameter": {"type": "integer", "minimum": 1, "maximum": 48}, "worsening_parameter": {"type": "integer", "minimum": 1, "maximum": 48},
    "recommended_principles": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 40}},
    "transcription_receipts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["check_id", "method", "source_sha256", "page", "normalized_cell_sha256"], "properties": {"check_id": {"type": "string", "minLength": 1}, "method": {"const": "independent_visual_transcription"}, "source_sha256": {"const": "65fc567d9d76b95d462fa0e89bddac8d0db481780691d90ec11a06c9e75b32c8"}, "page": {"const": 1}, "normalized_cell_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "inference_prohibited": {"const": true},
    "rights": {"type": "object", "additionalProperties": false, "required": ["status", "locator_only"], "properties": {"status": {"const": "public_reference_external"}, "locator_only": {"const": true}}}
  }
}
