{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["artifact_class", "protocol_id", "status", "claim_ids", "input_bindings", "stages"],
  "properties": {
    "artifact_class": {"const": "exp002-auto-schedule"},
    "protocol_id": {"const": "exp002-auto-v1.0.0"},
    "status": {"const": "frozen_no_model"},
    "claim_ids": {"type": "array", "maxItems": 0},
    "input_bindings": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "stages": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
