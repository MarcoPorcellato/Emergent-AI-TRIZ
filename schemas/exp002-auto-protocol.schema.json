{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["artifact_class", "protocol_id", "status", "scientific_status", "evidence_eligible", "expert_validated", "claim_ids", "models", "approval_boundary", "stages"],
  "properties": {
    "artifact_class": {"const": "exp002-auto-protocol"},
    "protocol_id": {"const": "exp002-auto-v1.0.0"},
    "status": {"enum": ["draft", "frozen_no_model", "approval_requested"]},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "models": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "required": ["model_id", "revision"], "properties": {"model_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}, "additionalProperties": false}},
    "approval_boundary": {"type": "object", "required": ["model_load", "tokenizer_construction", "generation", "sealed_target_read", "network", "ccp_material_run", "new_download"], "properties": {"model_load": {"const": false}, "tokenizer_construction": {"const": false}, "generation": {"const": false}, "sealed_target_read": {"const": false}, "network": {"const": false}, "ccp_material_run": {"const": false}, "new_download": {"const": false}}, "additionalProperties": false},
    "stages": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "required": ["stage_id", "model_access", "target_access"], "properties": {"stage_id": {"enum": ["AUTO-0", "AUTO-1", "AUTO-2", "AUTO-3", "AUTO-4", "AUTO-5"]}, "model_access": {"const": false}, "target_access": {"const": false}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
