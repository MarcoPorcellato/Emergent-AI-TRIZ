{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/dataset-annotation.schema.json",
  "title": "Latent TRIZ dataset annotation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotation_id",
    "case_id",
    "rater_id",
    "label",
    "non_empirical",
    "annotated_at"
  ],
  "properties": {
    "annotation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "rater_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "non_empirical": {"type": "boolean"},
    "annotated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "minLength": 1},
    "guide_revision": {"type": "string", "minLength": 1},
    "guide_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
