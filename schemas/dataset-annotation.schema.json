{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/dataset-annotation.schema.json",
  "title": "Latent TRIZ dataset annotation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotation_id",
    "case_id",
    "rater_id",
    "label",
    "confidence",
    "rationale",
    "operator_presence",
    "operator_essentiality",
    "contradiction_resolution",
    "solution_feasibility",
    "guide_revision",
    "guide_sha256",
    "case_payload_sha256",
    "dataset_batch_sha256",
    "display_view_version",
    "session_id",
    "non_empirical",
    "annotated_at"
  ],
  "properties": {
    "annotation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "rater_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {"type": "string", "enum": ["segmentation","inversion","both","other","abstain"]},
    "non_empirical": {"type": "boolean"},
    "annotated_at": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "minLength": 1},
    "guide_revision": {"type": "string", "minLength": 1},
    "guide_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_batch_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "display_view_version": {"type": "string", "const": "v1.1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "operator_presence": {"type": "integer", "minimum": 0, "maximum": 3},
    "operator_essentiality": {"type": "integer", "minimum": 0, "maximum": 3},
    "contradiction_resolution": {"type": "integer", "minimum": 0, "maximum": 4},
    "solution_feasibility": {"type": "integer", "minimum": 0, "maximum": 4},
    "alternative_principle": {"type": "string", "minLength": 1}
  }
}
