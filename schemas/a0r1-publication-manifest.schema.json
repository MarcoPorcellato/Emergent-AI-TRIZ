{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0r1-publication-manifest.schema.json",
  "title": "A0-R1 publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "empirical",
    "scientific_status",
    "evidence_eligible",
    "expert_validated",
    "claim_ids",
    "created_at",
    "status",
    "result_status",
    "result",
    "recovered_result",
    "recovery_receipt",
    "activation_receipt",
    "representation_index",
    "activation_dense",
    "report",
    "verification",
    "publication_access",
    "run_access",
    "result_metrics"
  ],
  "properties": {
    "artifact_class": {"type": "string", "const": "a0r1-publication-manifest"},
    "empirical": {"type": "boolean", "const": true},
    "scientific_status": {"type": "string", "const": "exploratory"},
    "evidence_eligible": {"type": "boolean", "const": false},
    "expert_validated": {"type": "boolean", "const": false},
    "claim_ids": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "const": "pass"},
    "result_status": {"type": "string", "enum": ["positive", "null"]},
    "result": {"$ref": "#/$defs/hash_path"},
    "recovered_result": {"$ref": "#/$defs/hash_path"},
    "recovery_receipt": {"$ref": "#/$defs/hash_path"},
    "activation_receipt": {"$ref": "#/$defs/hash_path"},
    "representation_index": {"$ref": "#/$defs/hash_path"},
    "activation_dense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recovery", "required"],
      "properties": {
        "status": {"type": "string", "const": "pass"},
        "recovery": {"type": "string", "const": "pass"},
        "required": {"type": "boolean", "const": true}
      }
    },
    "publication_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_output", "sealed_model_output", "sealed_targets"],
      "properties": {
        "model_output": {"type": "string", "const": "not_accessed"},
        "sealed_model_output": {"type": "string", "const": "not_accessed"},
        "sealed_targets": {"type": "string", "const": "not_accessed"}
      }
    },
    "run_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_output", "sealed_model_output", "sealed_targets"],
      "properties": {
        "model_output": {"type": "string", "const": "accessed"},
        "sealed_model_output": {"type": "string", "const": "accessed"},
        "sealed_targets": {"type": "string", "const": "accessed"}
      }
    },
    "result_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro_f1_margin_over_surface",
        "primary_permutation_p",
        "max_family_successes_observed",
        "domain_direction_success_count"
      ],
      "properties": {
        "macro_f1_margin_over_surface": {"type": "number"},
        "primary_permutation_p": {"type": "number"},
        "max_family_successes_observed": {"type": "integer", "minimum": 0},
        "domain_direction_success_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "hash_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
