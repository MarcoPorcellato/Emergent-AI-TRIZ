{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0-freeze-manifest.schema.json",
  "title": "A0 frozen protocol manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "protocol_id",
    "protocol_hash",
    "corpus_manifest_sha256",
    "cases_sha256",
    "calibration_targets_sha256",
    "sealed_targets_sha256",
    "sealed_targets_accessed",
    "selected",
    "calibration_artifact_hashes",
    "empirical",
    "scientific_status",
    "evidence_eligible",
    "expert_validated",
    "claim_ids",
    "status"
  ],
  "properties": {
    "artifact_class": {
      "type": "string",
      "const": "a0-protocol-freeze-manifest"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "corpus_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cases_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "calibration_targets_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sealed_targets_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sealed_targets_accessed": {
      "type": "boolean",
      "const": false
    },
    "selected": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "families_per_domain",
        "family_count",
        "permutation_budget",
        "critical_successes",
        "minimum_detectable_effect"
      ],
      "properties": {
        "families_per_domain": {
          "type": "integer",
          "minimum": 1
        },
        "family_count": {
          "type": "integer",
          "minimum": 1
        },
        "permutation_budget": {
          "type": "integer",
          "minimum": 1
        },
        "critical_successes": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_detectable_effect": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "calibration_artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["power.json", "shortcuts.json", "summary.json"],
      "properties": {
        "power.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "shortcuts.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "summary.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "empirical": {
      "type": "boolean",
      "const": true
    },
    "scientific_status": {
      "type": "string",
      "const": "exploratory"
    },
    "evidence_eligible": {
      "type": "boolean",
      "const": false
    },
    "expert_validated": {
      "type": "boolean",
      "const": false
    },
    "claim_ids": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": ["frozen", "failed"]
    }
  }
}
