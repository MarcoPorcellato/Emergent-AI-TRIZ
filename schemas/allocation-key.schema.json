{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/allocation-key.schema.json",
  "title": "Sealed blinded allocation key",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "non_empirical", "allocations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "sealed"},
    "non_empirical": {"const": true},
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packet_id", "arms_by_blind"],
        "properties": {
          "packet_id": {"type": "string", "minLength": 1},
          "arms_by_blind": {
            "type": "object",
            "additionalProperties": false,
            "required": ["A", "B"],
            "properties": {
              "A": {"type": "string", "enum": ["control", "treatment"]},
              "B": {"type": "string", "enum": ["control", "treatment"]}
            }
          }
        }
      }
    }
  }
}
