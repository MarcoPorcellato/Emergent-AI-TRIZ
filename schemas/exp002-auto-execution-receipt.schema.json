{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "protocol_id", "run_id", "model_id", "revision", "status", "execution", "access", "scientific_status", "evidence_eligible", "expert_validated", "claim_ids"],
  "properties": {
    "artifact_class": {"const": "exp002-auto-execution-receipt"},
    "protocol_id": {"const": "exp002-auto-v1.0.0"},
    "run_id": {"type": "string", "pattern": "^exp002-auto-[a-z0-9-]+$"},
    "model_id": {"type": ["null", "string"]},
    "revision": {"type": ["null", "string"], "pattern": "^[a-f0-9]{40}$"},
    "status": {"enum": ["not_started", "auto_proxy_signal", "null", "failed", "non_interpretable", "incompatible"]},
    "execution": {"type": "object"},
    "access": {"type": "object"},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0}
  }
}
