{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0-case.schema.json",
  "title": "A0 case surface record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "problem_family_id",
    "solution_variant_id",
    "domain",
    "split",
    "problem",
    "constraints",
    "initial_state",
    "desired_improvement",
    "worsening_consequence",
    "transformation",
    "resulting_state",
    "solution",
    "provenance",
    "target_content_sha256",
    "case_content_sha256"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "problem_family_id": {
      "type": "string",
      "minLength": 1
    },
    "solution_variant_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "enum": ["calibration", "sealed"]
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "initial_state": {
      "type": "string",
      "minLength": 1
    },
    "desired_improvement": {
      "type": "string",
      "minLength": 1
    },
    "worsening_consequence": {
      "type": "string",
      "minLength": 1
    },
    "transformation": {
      "type": "string",
      "minLength": 1
    },
    "resulting_state": {
      "type": "string",
      "minLength": 1
    },
    "solution": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "template_id",
        "generator_id",
        "license"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "generator_id": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "const": "Apache-2.0"
        }
      }
    },
    "target_content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "case_content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
