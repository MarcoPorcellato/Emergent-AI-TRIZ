{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp001-comparative-execution-authorization.schema.json",
  "title": "EXP-001 comparative execution authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "dossier_id", "protocol_id", "status", "exact_models", "permissions_requested", "limits", "prohibitions", "operator_approval"],
  "properties": {
    "artifact_class": {"const": "exp001-comparative-execution-authorization"},
    "dossier_id": {"const": "exp001-comparative-execution-approval-v1"},
    "protocol_id": {"const": "exp001-reference-comparative-v1.0.0"},
    "status": {"enum": ["approval_requested", "authorized", "running", "published", "rejected"]},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "exact_models": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["model_id", "revision", "local_root"], "properties": {"model_id": {"type": "string"}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "local_root": {"type": "string", "pattern": "^artifacts/models/[a-z0-9.-]+$"}}}},
    "permissions_requested": {"type": "object", "additionalProperties": false, "required": ["download_qwen_runtime_files_only", "load_existing_pythia_once", "load_existing_smollm2_once", "load_qwen_once_after_integrity", "local_cpu_float32", "network", "generation", "sealed_target_read", "publish_every_terminal_outcome", "publish_dense_asset_content"], "properties": {"download_qwen_runtime_files_only": {"const": true}, "load_existing_pythia_once": {"const": true}, "load_existing_smollm2_once": {"const": true}, "load_qwen_once_after_integrity": {"const": true}, "local_cpu_float32": {"const": true}, "network": {"const": false}, "generation": {"const": false}, "sealed_target_read": {"const": "exactly_one_per_model_at_analysis_boundary"}, "publish_every_terminal_outcome": {"const": true}, "publish_dense_asset_content": {"const": false}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["wall_time_seconds_per_model", "peak_rss_bytes_per_model", "new_dense_output_bytes_per_model", "qwen_disk_budget_bytes"], "properties": {"wall_time_seconds_per_model": {"const": 1800}, "peak_rss_bytes_per_model": {"const": 8589934592}, "new_dense_output_bytes_per_model": {"const": 134217728}, "qwen_disk_budget_bytes": {"const": 1610612736}}},
    "prohibitions": {"type": "array", "minItems": 6, "items": {"type": "string"}},
    "operator_approval": {"type": "object", "additionalProperties": false, "required": ["granted", "operator_id", "approved_at", "approval_text_sha256"], "properties": {"granted": {"const": true}, "operator_id": {"const": "MarcoPorcellato"}, "approved_at": {"type": "string", "minLength": 1}, "approval_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  }
}
