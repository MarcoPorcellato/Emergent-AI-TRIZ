{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/lab04-result.schema.json",
  "title": "Latent TRIZ Lab 04 decodability result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class", "status", "empirical", "evidence_eligible", "claim_ids",
    "interpretation", "non_claim_boundary", "hashes", "predecessors",
    "case_summary", "random_control", "config", "layers", "gates", "issues",
    "summary_artifacts"
  ],
  "properties": {
    "artifact_class": {"const": "representation-decodability-instrumentation"},
    "status": {"enum": ["pass", "fail"]},
    "empirical": {"const": false},
    "evidence_eligible": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "interpretation": {"const": "diagnostic_only_not_scientifically_interpretable"},
    "non_claim_boundary": {
      "type": "string",
      "pattern": "No Latent TRIZ claim.*Decodability is correlational, not causal"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases_jsonl", "representations_jsonl", "config_json", "probe_result_json", "report_html", "summary_json"],
      "properties": {
        "cases_jsonl": {"$ref": "#/$defs/sha256"},
        "representations_jsonl": {"$ref": "#/$defs/sha256"},
        "config_json": {"$ref": "#/$defs/sha256"},
        "probe_result_json": {"$ref": "#/$defs/sha256"},
        "report_html": {"$ref": "#/$defs/sha256"},
        "summary_json": {"$ref": "#/$defs/sha256"}
      }
    },
    "predecessors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lab01", "lab02", "lab03"],
      "properties": {
        "lab01": {"$ref": "#/$defs/predecessor"},
        "lab02": {"$ref": "#/$defs/predecessor"},
        "lab03": {"$ref": "#/$defs/predecessor"}
      }
    },
    "case_summary": {"type": "object"},
    "random_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "permutations", "method", "formula", "max_statistic"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "permutations": {"type": "integer", "minimum": 1},
        "method": {"type": "string", "pattern": "inner alpha selection repeated"},
        "formula": {"const": "p=(1+null>=observed)/(1+n)"},
        "max_statistic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected_layer", "max_statistic_p", "null_count", "null_sha256", "signature", "configured_alpha"],
          "properties": {
            "selected_layer": {"type": ["integer", "null"], "minimum": 0},
            "max_statistic_p": {"type": "number", "minimum": 0, "maximum": 1},
            "null_count": {"type": "integer", "minimum": 0},
            "null_sha256": {"$ref": "#/$defs/sha256"},
            "signature": {"const": "max_statistic_family_wise"},
            "configured_alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numeric_backend", "numeric_solver", "numeric_library_version", "minimum_labels", "minimum_domains", "minimum_cases_per_label_domain_cell", "alphas", "max_statistic", "permutation_blocks", "reselect_within_each_permutation", "permutations", "seed", "significance_alpha"],
      "properties": {
        "numeric_backend": {"enum": ["pure_python", "numpy"]},
        "numeric_solver": {"enum": ["pure_python_normal_equations_reference", "numpy_augmented_lstsq"]},
        "numeric_library_version": {"enum": ["none", "2.4.3"]},
        "minimum_labels": {"type": "integer", "minimum": 2},
        "minimum_domains": {"type": "integer", "minimum": 2},
        "minimum_cases_per_label_domain_cell": {"type": "integer", "minimum": 1},
        "alphas": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
        "max_statistic": {"const": "outer_fold_macro_f1_max"},
        "permutation_blocks": {"const": "outer_training_domain"},
        "reselect_within_each_permutation": {"const": true},
        "permutations": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "significance_alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"numeric_backend": {"const": "numpy"}}},
          "then": {"properties": {"numeric_solver": {"const": "numpy_augmented_lstsq"}, "numeric_library_version": {"const": "2.4.3"}}},
          "else": {"properties": {"numeric_solver": {"const": "pure_python_normal_equations_reference"}, "numeric_library_version": {"const": "none"}}}
        }
      ]
    },
    "layers": {"type": "array", "items": {"type": "object"}},
    "gates": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate", "status", "details"],
        "properties": {
          "gate": {"enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8"]},
          "status": {"enum": ["pass", "fail"]},
          "details": {"type": "string", "minLength": 1}
        }
      }
    },
    "issues": {"type": "array"},
    "summary_artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["generated_by", "readiness_statement", "probe_result", "html", "summary"],
      "properties": {
        "generated_by": {"const": "lab04_report_renderer"},
        "readiness_statement": {"type": "string", "minLength": 1},
        "probe_result": {"const": "probe_result.json"},
        "html": {"const": "report.html"},
        "summary": {"const": "summary.json"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "summary_sha256"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "summary_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
