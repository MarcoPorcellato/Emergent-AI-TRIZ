{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0r1-preoutput-summary.schema.json",
  "title": "A0-R1 pre-output summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "protocol_id",
    "protocol_status",
    "empirical",
    "scientific_status",
    "evidence_eligible",
    "expert_validated",
    "claim_ids",
    "independence_ready",
    "independence_status",
    "shortcuts_ready",
    "shortcuts_status",
    "candidate_sealed_targets_accessed_by_independence_audit",
    "candidate_sealed_targets_accessed_by_shortcut_audit",
    "model_output_accessed",
    "status"
  ],
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
      "then": {
        "properties": {
          "independence_ready": {"const": true},
          "independence_status": {"const": "pass"},
          "shortcuts_ready": {"const": true},
          "shortcuts_status": {"const": "pass"}
        }
      }
    }
  ],
  "properties": {
    "artifact_class": {
      "type": "string",
      "const": "a0-r1-preoutput-summary"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^a0-r1-tier-r1-v\\d+\\.\\d+$"
    },
    "protocol_status": {
      "type": "string",
      "const": "planned"
    },
    "empirical": {
      "type": "boolean",
      "const": true
    },
    "scientific_status": {
      "type": "string",
      "const": "exploratory"
    },
    "evidence_eligible": {
      "type": "boolean",
      "const": false
    },
    "expert_validated": {
      "type": "boolean",
      "const": false
    },
    "claim_ids": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "independence_ready": {
      "type": "boolean"
    },
    "independence_status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "shortcuts_ready": {
      "type": "boolean"
    },
    "shortcuts_status": {
      "type": "string",
      "enum": ["pass", "failed", "non_interpretable"]
    },
    "candidate_sealed_targets_accessed_by_independence_audit": {
      "type": "boolean",
      "const": true
    },
    "candidate_sealed_targets_accessed_by_shortcut_audit": {
      "type": "boolean",
      "const": false
    },
    "model_output_accessed": {
      "type": "boolean",
      "const": false
    },
    "status": {
      "type": "string",
      "enum": ["pass", "failed", "non_interpretable"]
    }
  }
}
