{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp001-r3-item.schema.json",
  "title": "EXP-001 R3 task item",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_id", "stratum", "task_family", "problem_family", "domain", "source_ids", "locator", "derivation", "rights", "lexical_audit", "proximity_audit", "split", "prompt", "expected_response_mode"],
  "properties": {
    "item_id": {"type": "string", "pattern": "^exp001-r3-[a-z0-9-]+$"},
    "stratum": {"enum": ["TRIZ-blinded-transfer", "source-exposed-competence"]},
    "task_family": {"enum": ["principle", "matrix", "tool_edge", "abstention"]},
    "problem_family": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "locator": {"$ref": "#/$defs/locator"},
    "derivation": {"$ref": "#/$defs/derivation"},
    "rights": {"$ref": "#/$defs/rights"},
    "lexical_audit": {"$ref": "#/$defs/audit"},
    "proximity_audit": {"$ref": "#/$defs/audit"},
    "split": {"$ref": "#/$defs/split"},
    "prompt": {"type": "string", "minLength": 1},
    "expected_response_mode": {"enum": ["principle_choice", "matrix_cell", "tool_edge_choice", "abstain"]}
  },
  "allOf": [
    {"if": {"properties": {"stratum": {"const": "TRIZ-blinded-transfer"}}}, "then": {"properties": {"lexical_audit": {"properties": {"source_lexemes_present": {"const": false}}, "required": ["source_lexemes_present"]}, "proximity_audit": {"properties": {"canonical_example_proximity": {"const": false}}, "required": ["canonical_example_proximity"]}}}},
    {"if": {"properties": {"stratum": {"const": "source-exposed-competence"}}}, "then": {"properties": {"derivation": {"properties": {"exposure_context_id": {"type": "string", "minLength": 1}}, "required": ["exposure_context_id"]}}}}
  ],
  "$defs": {
    "locator": {"type": "object", "additionalProperties": false, "required": ["source_id", "kind", "value"], "properties": {"source_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["page", "table", "section", "edge"]}, "value": {"type": "string", "minLength": 1}}},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["method", "independent_author", "verbatim_copy", "source_wording_used"], "properties": {"method": {"enum": ["independent_paraphrase", "controlled_transcription", "paired_variant"]}, "independent_author": {"type": "string", "minLength": 1}, "verbatim_copy": {"const": false}, "source_wording_used": {"const": false}, "exposure_context_id": {"type": "string"}}},
    "rights": {"type": "object", "additionalProperties": false, "required": ["status", "redistribution_allowed", "locator_only"], "properties": {"status": {"enum": ["public_reference_external", "user_attributed_unverified", "independently_authored"]}, "redistribution_allowed": {"const": false}, "locator_only": {"const": true}}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["source_lexemes_present", "score", "method", "reviewed"], "properties": {"source_lexemes_present": {"type": "boolean"}, "canonical_example_proximity": {"type": "boolean"}, "score": {"type": "number", "minimum": 0, "maximum": 1}, "method": {"type": "string", "minLength": 1}, "reviewed": {"const": true}}},
    "split": {"type": "object", "additionalProperties": false, "required": ["source_family", "problem_family", "held_out_domain", "pooling_prohibited"], "properties": {"source_family": {"type": "string", "minLength": 1}, "problem_family": {"type": "string", "minLength": 1}, "held_out_domain": {"type": "boolean"}, "pooling_prohibited": {"const": true}}}
  }
}
