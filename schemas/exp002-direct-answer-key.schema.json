{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp002-direct-answer-key.schema.json",
  "title": "EXP-002 direct TRIZ answer-key gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "key_id", "protocol_id", "status", "question_bank", "question_bank_sha256", "records", "expert_review", "model_access", "sealed_target_access", "scientific_status", "claim_ids"],
  "properties": {
    "artifact_class": {"const": "exp002-direct-answer-key"},
    "key_id": {"const": "exp002-direct-answer-key-v1.0.0"},
    "protocol_id": {"const": "exp002-qwen3-followup-v1.0.0"},
    "status": {"enum": ["not_ready", "expert_review", "frozen"]},
    "question_bank": {"const": "experiments/exp002-qwen3-followup/question-bank-manifest.json"},
    "question_bank_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "expert_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "reviewer_count", "reviewer_ids", "disagreement_policy"],
      "properties": {
        "required": {"const": true},
        "status": {"enum": ["pending", "complete"]},
        "reviewer_count": {"type": "integer", "minimum": 0},
        "reviewer_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{2,64}$"}, "uniqueItems": true},
        "disagreement_policy": {"const": "unresolved_records_remain_rubric_required"}
      }
    },
    "model_access": {"const": false},
    "sealed_target_access": {"const": false},
    "scientific_status": {"const": "exploratory"},
    "claim_ids": {"type": "array", "maxItems": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "not_ready"}}},
      "then": {"properties": {"records": {"maxItems": 0}, "expert_review": {"properties": {"status": {"const": "pending"}, "reviewer_ids": {"maxItems": 0}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "expert_review"}}},
      "then": {"properties": {"records": {"minItems": 1}, "expert_review": {"properties": {"status": {"const": "pending"}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "frozen"}}},
      "then": {"properties": {"records": {"minItems": 1}, "expert_review": {"properties": {"status": {"const": "complete"}, "reviewer_count": {"minimum": 3}, "reviewer_ids": {"minItems": 3}}}}}
    }
  ],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "key_type", "expert_status"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^exp002-"},
        "key_type": {"enum": ["exact", "abstention", "rubric_required", "non_evidential"]},
        "expected": {},
        "unsupported": {"type": "boolean"},
        "expert_status": {"enum": ["pending", "reviewed"]}
      },
      "allOf": [
        {"if": {"properties": {"key_type": {"enum": ["exact", "abstention"]}}}, "then": {"required": ["expected"]}}
      ]
    }
  }
}
