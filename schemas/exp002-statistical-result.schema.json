{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-triz.org/schemas/exp002-statistical-result.schema.json",
  "title": "EXP-002 statistical result",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_class", "protocol_id", "study_id", "model_id", "revision", "status", "scientific_status", "evidence_eligible", "expert_validated", "claim_ids", "pooling"],
  "properties": {
    "artifact_class": {"const": "exp002-statistical-result"},
    "protocol_id": {"const": "exp002-qwen3-followup-v1.0.0"},
    "study_id": {"enum": ["EXP-002A", "EXP-002B", "EXP-002C", "EXP-002D"]},
    "model_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "status": {"enum": ["positive", "null", "failed", "non_interpretable", "incompatible"]},
    "analysis": {"type": "object"},
    "failure": {"type": ["object", "null"]},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0},
    "pooling": {"const": "forbidden_across_models_and_studies"}
  }
}
