{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/study.schema.json",
  "title": "Latent TRIZ study manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_id",
    "title",
    "track",
    "stage",
    "status",
    "hypothesis",
    "preregistration",
    "dataset",
    "models",
    "primary_metrics",
    "controls",
    "code_revision",
    "timestamps"
  ],
  "properties": {
    "study_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "minLength": 6
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "type": "string",
      "enum": ["track_a_pretrained", "track_b_controlled", "both"]
    },
    "stage": {
      "type": "string",
      "enum": [
        "stage_1_dataset",
        "stage_2_baselines",
        "stage_3_representations",
        "stage_4_causal_steering",
        "stage_5_composition",
        "stage_6_replication",
        "completed"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["designed", "preregistered", "running", "complete", "archived", "suspended"]
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "preregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prereg_id", "artifact_path", "version", "registered_at"],
      "properties": {
        "prereg_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "registered_at": {
          "type": "string",
          "format": "date-time"
        },
        "amended_from": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "snapshot_uri", "immutable_revision", "splits"],
      "properties": {
        "dataset_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "snapshot_uri": {
          "type": "string",
          "minLength": 1
        },
        "immutable_revision": {
          "type": "string",
          "minLength": 1
        },
        "splits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "discovery",
              "within_domain_validation",
              "leave_one_domain_out",
              "lexical_adversarial",
              "near_miss_control",
              "alternative_solution_control",
              "sealed_novel"
            ]
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "family", "revision", "variant"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": "string",
            "enum": ["base", "instruction_tuned", "trained_from_scratch", "other"]
          }
        }
      }
    },
    "primary_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "success_criterion"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "success_criterion": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "number"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "code_revision": {
      "type": "string",
      "minLength": 1
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "preregistered_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
