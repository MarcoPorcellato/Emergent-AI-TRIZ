{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/a0-calibration-summary.schema.json",
  "title": "A0 calibration summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "protocol_id",
    "protocol_status",
    "empirical",
    "scientific_status",
    "evidence_eligible",
    "expert_validated",
    "claim_ids",
    "status",
    "power_status",
    "shortcut_status",
    "selected",
    "sealed_targets_accessed",
    "limitations"
  ],
  "properties": {
    "artifact_class": {
      "type": "string",
      "const": "a0-calibration-summary"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_status": {
      "type": "string",
      "enum": ["proposed", "frozen"]
    },
    "empirical": {
      "type": "boolean",
      "const": true
    },
    "scientific_status": {
      "type": "string",
      "const": "exploratory"
    },
    "evidence_eligible": {
      "type": "boolean",
      "const": false
    },
    "expert_validated": {
      "type": "boolean",
      "const": false
    },
    "claim_ids": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": ["pass", "failed"]
    },
    "power_status": {
      "type": "string",
      "enum": ["pass", "failed_no_feasible_candidate"]
    },
    "shortcut_status": {
      "type": "string",
      "enum": ["pass", "failed", "non_interpretable"]
    },
    "selected": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "families_per_domain",
        "family_count",
        "permutation_budget",
        "critical_successes",
        "minimum_detectable_effect"
      ],
      "properties": {
        "families_per_domain": {
          "type": "integer",
          "minimum": 1
        },
        "family_count": {
          "type": "integer",
          "minimum": 1
        },
        "permutation_budget": {
          "type": "integer",
          "minimum": 1
        },
        "critical_successes": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_detectable_effect": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "sealed_targets_accessed": {
      "type": "boolean",
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
