{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/Latent-TRIZ/schemas/case.schema.json",
  "title": "Latent TRIZ problem-solution case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "domain",
    "problem",
    "constraints",
    "initial_state",
    "desired_improvement",
    "worsening_consequence",
    "transformation",
    "resulting_state",
    "labels",
    "provenance"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "domain": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "initial_state": {"type": "string", "minLength": 1},
    "desired_improvement": {"type": "string", "minLength": 1},
    "worsening_consequence": {"type": "string", "minLength": 1},
    "transformation": {"type": "string", "minLength": 1},
    "resulting_state": {"type": "string", "minLength": 1},
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principle", "annotator_id"],
        "properties": {
          "principle": {"type": "string", "minLength": 1},
          "annotator_id": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string"}
        }
      },
      "minItems": 1
    },
    "lexical_controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbidden_terms": {"type": "array", "items": {"type": "string"}},
        "matched_case_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "near_miss_case_ids": {"type": "array", "items": {"type": "string"}},
    "alternative_solution_case_ids": {"type": "array", "items": {"type": "string"}},
    "split": {
      "type": "string",
      "enum": ["discovery", "validation", "held_out_domain", "sealed_novel"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "license", "created_at"],
      "properties": {
        "source_type": {"type": "string", "enum": ["human_authored", "model_generated", "adapted", "historical"]},
        "generator_id": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "format": "uri"},
        "template_id": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date"},
        "notes": {"type": "string"}
      }
    }
  }
}
