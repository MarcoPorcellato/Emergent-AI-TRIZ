{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["artifact_class", "protocol_id", "model_id", "revision", "status", "scientific_status", "evidence_eligible", "expert_validated", "claim_ids"],
  "properties": {
    "artifact_class": {"const": "exp002-auto-result"},
    "protocol_id": {"const": "exp002-auto-v1.0.0"},
    "model_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "status": {"enum": ["auto_proxy_signal", "null", "failed", "non_interpretable", "incompatible"]},
    "scientific_status": {"const": "exploratory"},
    "evidence_eligible": {"const": false},
    "expert_validated": {"const": false},
    "claim_ids": {"type": "array", "maxItems": 0}
  }
}
